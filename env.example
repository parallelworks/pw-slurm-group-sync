# Group Source
# ------------
# Where to read group membership from:
#   api      - ACTIVATE REST API (default; requires ACTIVATE_* below)
#   nsscache - local nsscache group cache file; no API access needed.
#              Requires SLURM_CLUSTER and SLURM_ACCOUNT_ORG (or
#              ACTIVATE_ORG_NAME to derive them) and does not support
#              SYNC_ALLOCATIONS.
# GROUPS_SOURCE=api

# Path to the nsscache group cache (nsscache mode only)
# NSSCACHE_GROUP_FILE=/etc/group.cache

# ACTIVATE API Configuration (api mode)
# --------------------------------------
# API key for ACTIVATE authentication. The platform URL and organization
# are derived from the key; the ACTIVATE_* settings below are overrides.
# Generate at: Account > Authentication > API Keys
ACTIVATE_API_KEY=pwt_your_api_key_here

# Organization slug (optional, resolved from the API key)
# ACTIVATE_ORG_NAME=myorganization

# Base URL of the ACTIVATE API (optional, embedded in the API key)
# ACTIVATE_API_URL=https://activate.parallel.works

# Slurm Configuration
# -------------------
# Slurm cluster name. Defaults to the org name (api mode); when unset and
# slurmdbd has exactly one cluster, that cluster is used.
# SLURM_CLUSTER=mycluster

# Organization value written to Slurm accounts (defaults to the org name).
# Required in nsscache mode.
# SLURM_ACCOUNT_ORG=myorganization

# Sync Options
# ------------
# Comma-separated list of group names to sync. Leave empty to sync all groups.
# Useful for testing with a subset before full rollout.
# SYNC_GROUPS=TeamAlpha,TeamBeta

# Sync ACTIVATE group allocations to Slurm account GrpTRES limits.
# Off by default. Set to true to apply allocation values from ACTIVATE.
# SYNC_ALLOCATIONS=false

# The Slurm TRES resource type to set when syncing allocations (e.g., gres/gpu, cpu).
# SLURM_ALLOCATION_TRES=gres/gpu

# Set to true to log what would change without making any Slurm modifications.
# DRY_RUN=true

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Monitoring
# ----------
# Heartbeat URL pinged on successful sync completion (e.g., UptimeRobot).
# If the script fails before finishing, the heartbeat is not sent.
# HEARTBEAT_URL=https://heartbeat.uptimerobot.com/your-monitor-id
